 /*                                                                    */
@@ -214,3 +378,4 @@ void BinLogStat (int status, STATE *state, BINKD_CONFIG *config)
 	FDLogStat (state, config->fdinhist, config->fdouthist, config->tzoff);
 }
 
+#endif
